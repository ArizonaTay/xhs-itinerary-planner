# XHS Travel Planner — settings
#
# Everything is optional: the value after `=` is what the app uses when the
# variable is absent, except DEEPSEEK_API_KEY which must be filled in for AI
# generation (without it the AI endpoints answer 503).

# --- LLM (any OpenAI-compatible provider) -------------------------------------
# Not DeepSeek-only: point BASE_URL + MODEL at OpenAI, OpenRouter, Moonshot,
# a local Ollama, etc. The provider must support JSON mode
# (`response_format: {"type": "json_object"}`).
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# Examples:
#   OpenAI      DEEPSEEK_BASE_URL=https://api.openai.com/v1   DEEPSEEK_MODEL=gpt-4o-mini
#   OpenRouter  DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1 DEEPSEEK_MODEL=deepseek/deepseek-chat
#   Ollama      DEEPSEEK_BASE_URL=http://localhost:11434/v1    DEEPSEEK_MODEL=llama3.1
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_MAX_TOKENS_ITINERARY=4096
# DEEPSEEK_MAX_TOKENS_SHORT=3000
# DEEPSEEK_MAX_TOKENS_KEYWORD=200

# --- Xiaohongshu MCP ----------------------------------------------------------
# Sign-in happens through the app's QR prompt and lives in the xhs-mcp container;
# no Xiaohongshu cookie belongs here.
# XHS_MCP_URL=http://localhost:18060/mcp
# XHS_TIMEOUT_SECONDS=120
# XHS_SORT_BY=最新
# XHS_NOTE_TYPE=图文
# XHS_MAX_NOTES=20
# Optional: only if the container was started with AUTH_TOKEN.
# XHS_AUTH_TOKEN=

# --- Short-video limits -------------------------------------------------------
# SHORT_MIN_DURATION_SECONDS=15
# SHORT_DEFAULT_DURATION_SECONDS=30
# SHORT_MAX_DURATION_SECONDS=90
# SHORT_MAX_SCENES=10
# SHORT_MAX_SOURCES=5

# --- Server (used by `python main.py`; uvicorn flags win) ---------------------
# APP_TITLE=XHS Travel Planner
# APP_HOST=127.0.0.1
# APP_PORT=8000
