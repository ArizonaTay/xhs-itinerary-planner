# DeepSeek API key (get from https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Xiaohongshu cookie (required for xiaohongshu-mcp container)
# Instructions: Log into xiaohongshu.com, open DevTools > Application > Cookies, copy the full cookie string
XHS_COOKIE=your_xhs_cookie_here

# Xiaohongshu MCP Server URL (Streamable HTTP endpoint)
# Docker Compose: http://xhs-mcp:18060/mcp
# Manual container: http://localhost:18060/mcp
XHS_MCP_URL=http://localhost:18060/mcp
